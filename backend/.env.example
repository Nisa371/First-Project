# Spring Boot reads process environment variables, not .env files automatically.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Exact browser origins, comma-separated; no paths or wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# MySQL connection. The dev profile now uses MySQL instead of H2.
DB_URL=jdbc:mysql://localhost:3306/verified_career_marketplace?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD

# JWT: optional in dev/test (a new random key is generated at each startup).
# REQUIRED in prod: export JWT_SECRET using output from openssl rand -base64 32.
# JWT_SECRET=
JWT_TTL_SECONDS=3600

# Private CV storage, relative to backend working directory or an absolute path.
CV_STORAGE_DIRECTORY=uploads/cv

# Optional dev-only evaluator bootstrap. Export your own values; no default credentials.
# DEMO_EVALUATOR_EMAIL=
# DEMO_EVALUATOR_PASSWORD=
# APP_ASSESSMENTS_SEED_DEMO=false

# Optional populated fictional showcase (dev profile only).
DEMO_ENABLED=false
# Supply a private 10–72 byte password locally; never commit it.
# DEMO_PASSWORD=
