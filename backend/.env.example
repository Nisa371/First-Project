# Copy to .env; setup-db.sh and run-backend.sh load it. Spring Boot alone does not.
# Use KEY=value, optionally quoted. Values are literal (no shell expansion).
# Exported environment variables override .env values.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Exact browser origins, comma-separated; no paths or wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local/demo MySQL only; replace this public demo password for private use.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=verified_career_marketplace
DB_USERNAME=marketplace
DB_PASSWORD=marketplace123
# Optional advanced JDBC override for Spring Boot only: DB_URL.
# setup-db.sh uses local admin socket access and DB_NAME/DB_USERNAME/DB_PASSWORD.
# It creates a localhost account and updates its password on each run.

# JWT: optional in dev/test (a new random key is generated at each startup).
# REQUIRED in prod: export JWT_SECRET using output from openssl rand -base64 32.
# JWT_SECRET=
JWT_TTL_SECONDS=3600

# Private CV storage, relative to backend working directory or an absolute path.
CV_STORAGE_DIRECTORY=uploads/cv

# Optional dev-only evaluator bootstrap. Export your own values; no default credentials.
# DEMO_EVALUATOR_EMAIL=
# DEMO_EVALUATOR_PASSWORD=
# APP_ASSESSMENTS_SEED_DEMO=false

# Optional populated fictional showcase (dev profile only).
DEMO_ENABLED=false
# Supply a private 10–72 byte password locally; never commit it.
# DEMO_PASSWORD=
