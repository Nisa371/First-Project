# Configuration lives with each application:
# frontend/.env.example -> copy to frontend/.env (Vite loads this).
# backend/.env.example -> copy to backend/.env; use backend/run-backend.sh.
# Spring Boot does not automatically load .env files.
# Never put secrets in browser-visible VITE_* variables.

# Optional server-side Gemini text provider. Keep real keys in ignored backend/.env.
AI_PROVIDER=UNCONFIGURED
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Leave blank to use the model default thinking configuration.
GEMINI_THINKING_LEVEL=low
AI_TIMEOUT=30s
