# Conceptual placeholders only; no application loads this file yet.
# Actual variable names/loading and separate app files are finalized in M1.4.
# Real .env files are ignored. Never commit secrets or production values.
# Browser VITE_* variables are public: never place secrets in them.

# Backend / database
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Authentication (backend only)
JWT_SECRET=

# Frontend origin / backend CORS
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=

# Public frontend API address
VITE_API_BASE_URL=
